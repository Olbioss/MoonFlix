# Server configuration
PORT=5000

# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/moonflix

# Secret used to sign JWT access tokens (use a long random string)
TOKEN_SECRET=change_me_to_a_long_random_secret

# TMDB API (https://www.themoviedb.org/settings/api)
TMDB_BASE_URL=https://api.themoviedb.org/3/
TMDB_KEY=your_tmdb_api_key

# Comma-separated list of allowed CORS origins (used in Phase 6 hardening)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
